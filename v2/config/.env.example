# ====================
# SECRETS — copy this file to `.env` (same folder) and fill in your real values.
# `.env` is gitignored, so these values never end up on GitHub.
# ====================

# cPanel MySQL credentials
DB_USER=h421704
DB_PASS=your_database_password

# Random 32-char key used to encrypt sensitive data
SECURITY_KEY=replace_with_32_char_random_key

# Random token for cron.php access (e.g. https://yoursite.com/cron.php?token=...)
CRON_SECRET=replace_with_random_token